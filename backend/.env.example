# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://username:password@host:5432/database_name

# Example:
# DATABASE_URL=postgresql+psycopg://bizinsight:yourpassword@127.0.0.1:5432/nzcompanies

# Comma-separated list of allowed CORS origins ("*" allows all)
BACKEND_CORS_ORIGINS=*

# Admin page (/admin) for importing the monthly bulk data. Login is disabled while ADMIN_PASSWORD is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string that signs admin sessions, e.g. from: openssl rand -hex 32
ADMIN_SECRET_KEY=
# Set to false when running locally over plain http
ADMIN_COOKIE_SECURE=true
# Where uploaded bulk data is stored
DATA_DIR=/data

# Supabase Configuration (Optional)
SUPABASE_URL=
SUPABASE_KEY=
