# >>> companies.aicloud.co.nz (BIZInsight — /opt/webApp/bizinsight) >>>
# BIZInsight —— 新西兰公司数据查询 https://companies.aicloud.co.nz
# 追加到 /opt/webApp/caddy/Caddyfile 后热加载：
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
# 注意：Caddyfile 是以单个文件 bind mount 进容器的，修改时必须原地写入（>> 追加、或 cat > 覆盖），
# 不能用 sed -i / 编辑器"另存"这类会换 inode 的方式——否则容器里仍是旧内容，reload 不生效，
# 只能 docker restart shared-caddy（会让这台机器上所有站点中断几秒）。
# 容器（网络 shared-proxy-network）：
#   bizinsight-web     : 服务端渲染的站点（Node / React Router），监听 3000；自己处理 404、robots.txt、sitemap
#   bizinsight-backend : FastAPI，监听 8000（/api/*）
# 证书由 Caddy 自动签发/续期。HSTS 不带 includeSubDomains，以免影响其它 aicloud.co.nz 子域。
companies.aicloud.co.nz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 后台 /admin 上传每月的 bulk data（zip 约 230MB，解压后的 CSV 约 850MB），只有这一个接口放宽上限。
	@bulk_upload path /api/v1/admin/imports
	request_body @bulk_upload {
		max_size 2GB
	}
	@not_bulk_upload not path /api/v1/admin/imports
	request_body @not_bulk_upload {
		max_size 1MB
	}

	# 后台页面不要被搜索引擎收录
	header /admin* X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		reverse_proxy bizinsight-backend:8000
	}
	handle {
		reverse_proxy bizinsight-web:3000
	}
}
# <<< companies.aicloud.co.nz <<<
