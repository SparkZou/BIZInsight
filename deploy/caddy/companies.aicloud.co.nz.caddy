# >>> companies.aicloud.co.nz (BIZInsight — /opt/webApp/bizinsight) >>>
# BIZInsight —— 新西兰公司数据查询 https://companies.aicloud.co.nz
# 追加到 /opt/webApp/caddy/Caddyfile 后热加载：
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
# 容器（网络 shared-proxy-network）：
#   bizinsight-frontend : 前端静态 SPA（nginx），SPA fallback 在容器内部处理
#   bizinsight-backend  : FastAPI，监听 8000（/api/*）
# 证书由 Caddy 自动签发/续期。HSTS 不带 includeSubDomains，以免影响其它 aicloud.co.nz 子域。
companies.aicloud.co.nz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	request_body {
		max_size 1MB
	}
	handle /api/* {
		reverse_proxy bizinsight-backend:8000
	}
	handle {
		reverse_proxy bizinsight-frontend:80
	}
}
# <<< companies.aicloud.co.nz <<<
