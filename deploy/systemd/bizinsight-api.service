[Unit]
Description=BIZInsight API (FastAPI) for companies.aicloud.co.nz
After=network.target postgresql.service

[Service]
User=bizinsight
Group=bizinsight
WorkingDirectory=/opt/bizinsight/backend
ExecStart=/opt/bizinsight/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
